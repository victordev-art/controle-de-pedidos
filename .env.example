PORT=3000
DB_FILE=./data/pedidos.db

# Token que o DataCar (ou o middleware) envia no webhook: Authorization: Bearer <token>
INTEGRATION_TOKEN=troque-por-um-token-longo-e-secreto

# Modo PULL (opcional): o sistema consulta o DataCar a cada N segundos.
# {since} é substituído pela data/hora (ISO) da última consulta bem-sucedida.
DATACAR_POLL_URL=
DATACAR_POLL_TOKEN=
DATACAR_POLL_INTERVAL_S=30

# Retorno de status (opcional): avisa o DataCar a cada etapa concluída.
DATACAR_STATUS_CALLBACK_URL=
DATACAR_STATUS_CALLBACK_TOKEN=
